POSTGRES_DB=synarome_dispatch
POSTGRES_USER=synarome
POSTGRES_PASSWORD=change-me

DATABASE_URL=postgresql+psycopg2://synarome:change-me@db:5432/synarome_dispatch

SECRET_KEY=change-this-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

WHATSAPP_API_VERSION=v26.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEST_RECIPIENT=
WHATSAPP_CUSTOMER_TEST_RECIPIENT=
WHATSAPP_CUSTOMER_TEST_RECIPIENT
WHATSAPP_SEND_MODE=test
WHATSAPP_DEFAULT_COUNTRY_CODE=92

UPLOAD_DIR=/app/uploads

# Meta webhook verification token (choose a random value) and Meta app secret
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
