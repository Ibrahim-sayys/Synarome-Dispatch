POSTGRES_DB=synarome_dispatch
POSTGRES_USER=synarome
POSTGRES_PASSWORD=change-me

DATABASE_URL=postgresql+psycopg2://synarome:change-me@db:5432/synarome_dispatch

SECRET_KEY=change-this-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

WHATSAPP_API_VERSION=v26.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEST_RECIPIENT=
WHATSAPP_CUSTOMER_TEST_RECIPIENT=
WHATSAPP_SEND_MODE=test
WHATSAPP_DEFAULT_COUNTRY_CODE=92

# Replace these examples with the exact approved Meta template names and languages.
# NAME_PARAMETER is empty for {{1}}, or the parameter name for a named variable.
WHATSAPP_IMAGE_TEMPLATE_NAME=replace_with_image_template_name
WHATSAPP_IMAGE_TEMPLATE_LANGUAGE=replace_with_language_code
WHATSAPP_IMAGE_TEMPLATE_NAME_PARAMETER=
WHATSAPP_DOCUMENT_TEMPLATE_NAME=replace_with_document_template_name
WHATSAPP_DOCUMENT_TEMPLATE_LANGUAGE=replace_with_language_code
WHATSAPP_DOCUMENT_TEMPLATE_NAME_PARAMETER=

UPLOAD_DIR=/app/uploads

# Meta webhook verification token (choose a random value) and Meta app secret
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
